# /etc/gufo-pair/env — configuration for gufo-pairctl and the masquerade stack.
# Install with mode 0600 owned by the user that runs podman.
#
# The GUFO API key lives HERE and only here. It is never placed in the PAIR
# manifest: PAIR never authenticates to the shim, and the shim injects the key
# on every upstream call.

# --- credentials ---------------------------------------------------------
# Must match the --api-key GUFO was started with.
GUFO_API_KEY=REPLACE_WITH_GUFO_API_KEY

# --- topology -----------------------------------------------------------
SHIM_BIND=127.0.0.1
SHIM_PORT=8081
GUFO_BASE_URL=http://127.0.0.1:18080

POD_NAME=gufo-pair
GUFO_PAIR_POD=gufo-pair
GUFO_PAIR_COMPOSE=/opt/gufo-pair/compose.yaml
GUFO_PAIR_ENV=/etc/gufo-pair/env

# --- images -------------------------------------------------------------
GUFO_IMAGE=localhost/gufo:latest
SHIM_IMAGE=localhost/gufo-masquerade:1.1.0

# --- models -------------------------------------------------------------
# Model weights live here. NEVER deleted by gufo-pairctl destroy.
GUFO_MODELS_DIR=/srv/models/gufo
SERVED_MODEL_NAME=gufo-local

# --- shim behaviour -----------------------------------------------------
SHIM_STATE_PATH=/var/lib/gufo-masquerade/state.json
SHIM_LOG_LEVEL=info
SHIM_ACCESS_LOG=0
# Honest by default: refuse to claim we unloaded a live model.
SHIM_REFUSE_UNLOAD_SERVING=1
# present-ok | fake | reject
SHIM_PULL_POLICY=present-ok

# --- readiness ----------------------------------------------------------
GUFO_READY_TIMEOUT=180
